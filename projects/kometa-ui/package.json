{
  "name": "kometa-ui",
  "version": "0.3.0",
  "description": "Angular 22 UI kit: standalone OnPush components themed by CSS custom properties, light and dark.",
  "keywords": [
    "angular",
    "angular22",
    "ui-kit",
    "components",
    "signals",
    "standalone",
    "design-system",
    "dark-mode"
  ],
  "author": "Inomjon Ismaylov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InomjonIsmaylov/kometa-ui-kit.git",
    "directory": "projects/kometa-ui"
  },
  "homepage": "https://inomjonismaylov.github.io/kometa-ui-kit/",
  "bugs": {
    "url": "https://github.com/InomjonIsmaylov/kometa-ui-kit/issues"
  },
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "exports": {
    "./styles/*.css": "./styles/*.css",
    "./styles/*.scss": "./styles/*.scss",
    "./styles/*": {
      "sass": "./styles/*.scss",
      "default": "./styles/*"
    }
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  }
}
